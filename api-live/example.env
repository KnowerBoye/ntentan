GEMINI_API_KEY=
GHNLP_API_KEY=
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=path/to/google/application/credentials.json
FIREBASE_CREDENTIALS=path/to/firebase/credentials.json
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=
OPENFDA_API_KEY=OPENFDA_CRED

# ── Gemini Live API (this server only) ──
# Model IDs are env-driven because the Live API line-up changes. Pick models
# whose supportedGenerationMethods include bidiGenerateContent (list them with
# GET /v1beta/models?key=...). Assistant = native audio (best voice); scanner =
# flash-live (cascade) for text+video. Other options: gemini-3.8-live,
# gemini-3.1-flash-live-preview, gemini-2.5-flash-native-audio-latest.
LIVE_ASSISTANT_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
LIVE_SCANNER_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE_NAME=Aoede
PORT=8080

# ── GhanaNLP (Twi language layer) ──
# The assistant's Twi voice output is synthesized by GhanaNLP TTS (handles Twi
# better than the Live API's native audio) using GHNLP_API_KEY above.
# GHNLP_TTS_VOICE: "female" | "male". GHNLP_API_BASE rarely needs overriding.
GHNLP_TTS_VOICE=female
# GHNLP_API_BASE=https://translation-api.ghananlp.org

# ⚠️ DEV/TEST ONLY — DISABLES AUTHENTICATION.
# When true, the server trusts a raw user UID from the client instead of
# verifying a Firebase ID token (socket: auth.uid / ?uid=; REST: X-User-Id
# header). Anyone can act as any user. Used by the playgrounds and the
# test-live app so they can connect with just a UID. NEVER set in production.
# (Firestore still uses FIREBASE_CREDENTIALS — only token verification is skipped.)
ALLOW_UID_AUTH=true
