# Firebase Web SDK config — needed only for real sign-in (email/password + Google).
# Without these you can still use the app by pasting a Firebase ID token manually.
# Get these from Firebase console → Project settings → Your apps → Web app.
# They MUST belong to the same Firebase project whose admin creds the api-live
# server uses, or the server will reject the token.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Default api-live server URL (overridable in the UI).
VITE_DEFAULT_SERVER_URL=http://localhost:8080
